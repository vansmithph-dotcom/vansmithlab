# Copy to .env.local only for local development. Never commit real values.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Model names are configuration, not editorial policy.
OPENAI_MODEL=gpt-5-mini
ANTHROPIC_MODEL=claude-sonnet-4-6
GEMINI_MODEL=gemini-3.1-pro-preview

# Optional Figma Weave handoff. The v1 pipeline always writes a media brief;
# configure an authenticated webhook only when your Weave flow exposes one.
WEAVE_MEDIA_WEBHOOK_URL=
WEAVE_MEDIA_WEBHOOK_SECRET=
