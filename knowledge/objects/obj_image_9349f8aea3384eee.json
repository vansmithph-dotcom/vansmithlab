  "claims": [
    {
      "id": "clm_magazine-spread-space-betwee_def",
      "wording_ru": "Разворот — базовая пространственная единица печатной редакционной композиции: две соседние страницы, воспринимаемые одновременно. Он позволяет строить масштаб, ритм, контраст и переход между текстом и изображением.",
      "confidence_score": 0.72,
      "verification_state": "attributed"
    },
    {
      "id": "clm_magazine-spread-space-betwee_orig",
      "wording_ru": "Модернистская журнальная верстка XX века превратила разворот из технического соседства страниц в активное поле монтажа, где фотография могла пересекать сгиб, а пустое пространство — стать частью аргумента.",
      "confidence_score": 0.72,
      "verification_state": "attributed"
    },
    {
      "id": "clm_magazine-spread-space-betwee_form",
      "wording_ru": "Материал изображения включает носитель, оптику или исходный файл, свет, поверхность воспроизведения и метаданные; форма зависит от всей цепочки, а не только от момента съёмки. Производство требует точного понимания печатного формата, переплёта, безопасных зон, вылетов и того, какие элементы допустим",
      "confidence_score": 0.72,
      "verification_state": "attributed"
    },
    {
      "id": "clm_magazine-spread-space-betwee_use",
      "wording_ru": "Дизайнер работает с facing pages, сеткой, полями, колонками, линией сгиба, bleed и последовательностью разворотов; решения проверяются как внутри одного spread, так и в ритме всего материала.",
      "confidence_score": 0.72,
      "verification_state": "attributed"
    },
    {
      "id": "clm_magazine-spread-space-betwee_impact",
      "wording_ru": "Главное изменение для дисциплины — превращение изображения из единичного кадра в управляемую систему решений, версий, носителей и связей. левая страница ↔ сгиб ↔ правая страница → следующий разворот",
      "confidence_score": 0.72,
      "verification_state": "attributed"
    },
    {
      "id": "clm_magazine-spread-space-betwee_today",
      "wording_ru": "Сегодня тему следует читать как цепочку: левая страница ↔ сгиб ↔ правая страница → следующий разворот. Финальное изображение — видимая поверхность большого производственного процесса.",
      "confidence_score": 0.72,
      "verification_state": "attributed"
    }
  ],
