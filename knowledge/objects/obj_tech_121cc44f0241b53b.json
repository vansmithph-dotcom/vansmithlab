  "claims": [
    {
      "id": "clm_digital-photography-sensor-raw-production-chain_def",
      "wording_ru": "Кадр стал потоком данных от сенсора и RAW до цвета, метаданных и архива. Тема рассматривается как система отношений между данными, инструментом, человеком и результатом, а не как название отдельной программы или машины.",
      "confidence_score": 0.72,
      "verification_state": "attributed"
    },
    {
      "id": "clm_digital-photography-sensor-raw-production-chain_origin",
      "wording_ru": "В 1975 году инженер Kodak Стивен Сассон создал автономный CCD-прототип цифровой камеры. В 1990-х профессиональные системы расширили практическое применение, а массовые DSLR 2000-х ускорили переход редакционной и коммерческой фотографии.",
      "confidence_score": 0.72,
      "verification_state": "attributed"
    },
    {
      "id": "clm_digital-photography-sensor-raw-production-chain_method",
      "wording_ru": "Сенсор измеряет свет дискретными фоточувствительными элементами; демозаика восстанавливает цвет, а RAW сохраняет данные ближе к исходному сигналу и оставляет часть решений на этап проявки. Принципиально важно отделять цифровое описание от физического или визуального результата: между ними всегда сущ",
      "confidence_score": 0.72,
      "verification_state": "attributed"
    },
    {
      "id": "clm_digital-photography-sensor-raw-production-chain_case1",
      "wording_ru": "Прототип Стивена Сассона — фотография без плёнки. Этот пример важен как демонстрация базового принципа, а не только как историческая веха.",
      "confidence_score": 0.72,
      "verification_state": "attributed"
    },
    {
      "id": "clm_digital-photography-sensor-raw-production-chain_impact",
      "wording_ru": "Тема изменила дисциплину тем, что перераспределила решения между человеком, данными, программой, машиной и материалом. Кадр стал потоком данных от сенсора и RAW до цвета, метаданных и архива.",
      "confidence_score": 0.72,
      "verification_state": "attributed"
    },
    {
      "id": "clm_digital-photography-sensor-raw-production-chain_today",
      "wording_ru": "Современная камера сочетает оптический захват с вычислительной обработкой, но профессиональная надёжность по-прежнему зависит от экспозиции, качества исходника, цвета и архива.",
      "confidence_score": 0.72,
      "verification_state": "attributed"
    },
    {
