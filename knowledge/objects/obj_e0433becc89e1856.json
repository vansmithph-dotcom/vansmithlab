  "claims": [
    {
      "id": "clm_ca559bd2522ef683",
      "wording_ru": "Марсель Дюшан родился 28 июля 1887 года в Бленвиле, Франция, и умер 2 октября 1968 года в Нёйи, в семье, из которой вышли ещё трое художников — его дед по материнской линии и трое братьев и сестёр.",
      "claim_type": "attribution",
      "material": true,
      "verification_state": "verified",
      "confidence_score": 0.9,
      "evidence": [
        {
          "source_url": "https://www.britannica.com/biography/Marcel-Duchamp",
          "locator": "см. источник",
          "support": "Подтверждает утверждение"
        }
      ]
    },
    {
      "id": "clm_c8bd6ffdddc17a9c",
      "wording_ru": "Учился в Académie Julian в Париже в 1904-1905 годах, а к 1911 году вместе с братьями Раймоном Дюшан-Вийоном и Жаком Вийоном начал устраивать неформальные художественные салоны.",
      "claim_type": "attribution",
      "material": true,
      "verification_state": "verified",
      "confidence_score": 0.88,
      "evidence": [
        {
          "source_url": "https://www.britannica.com/biography/Marcel-Duchamp",
          "locator": "см. источник",
          "support": "Подтверждает утверждение"
        }
      ]
    },
    {
      "id": "clm_b1e72a9774b847df",
      "wording_ru": "Стал известен прежде всего реди-мейдами — обычными предметами, обозначенными им как произведения искусства; самые знаковые примеры — Bicycle Wheel (1913) и Fountain (1917), перевёрнутый промышленный писсуар, подписанный псевдонимом «R. Mutt» и выставленный в галерее.",
      "claim_type": "attribution",
      "material": true,
      "verification_state": "verified",
      "confidence_score": 0.9,
      "evidence": [
        {
