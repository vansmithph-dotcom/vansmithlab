  "claims": [
    {
      "id": "clm_photogrammetry-photography-as-spatial-measurement_def",
      "wording_ru": "Перекрывающиеся изображения становятся измерениями, из которых вычисляется пространство. Тема рассматривается как система отношений между данными, инструментом, человеком и результатом, а не как название отдельной программы или машины.",
      "confidence_score": 0.72,
      "verification_state": "attributed"
    },
    {
      "id": "clm_photogrammetry-photography-as-spatial-measurement_origin",
      "wording_ru": "Фотограмметрия исторически связана с картографией, аэрофотосъёмкой и измерительной фотографией. Цифровые камеры и автоматическое сопоставление признаков сделали её доступной для архитектуры, наследия, VFX и музейных коллекций.",
      "confidence_score": 0.72,
      "verification_state": "attributed"
    },
    {
      "id": "clm_photogrammetry-photography-as-spatial-measurement_method",
      "wording_ru": "Алгоритм ищет общие точки на перекрывающихся кадрах, оценивает положения камер, строит разреженное и плотное облако точек, затем сетку и текстуру. Масштаб и точность требуют контрольных данных. Принципиально важно отделять цифровое описание от физического или визуального результата: между ними всегд",
      "confidence_score": 0.72,
      "verification_state": "attributed"
    },
    {
      "id": "clm_photogrammetry-photography-as-spatial-measurement_case1",
      "wording_ru": "Ортофото — геометрически согласованное плоское изображение. Этот пример важен как демонстрация базового принципа, а не только как историческая веха.",
      "confidence_score": 0.72,
      "verification_state": "attributed"
    },
    {
      "id": "clm_photogrammetry-photography-as-spatial-measurement_impact",
      "wording_ru": "Тема изменила дисциплину тем, что перераспределила решения между человеком, данными, программой, машиной и материалом. Перекрывающиеся изображения становятся измерениями, из которых вычисляется пространство.",
      "confidence_score": 0.72,
      "verification_state": "attributed"
    },
    {
      "id": "clm_photogrammetry-photography-as-spatial-measurement_today",
      "wording_ru": "Сегодня фотограмметрия объединяется с LiDAR, геопространственными системами и облачной обработкой; её сила — совместное описание формы и фотографической поверхности.",
      "confidence_score": 0.72,
      "verification_state": "attributed"
    },
    {
      "id": "clm_photogrammetry-photography-as-spatial-measurement_tl_1934",
      "wording_ru": "основана American Society for Photogrammetry (1934)",
      "confidence_score": 0.72,
