  "claims": [
    {
      "id": "clm_3d-printing-production-without-traditional-tooling_def",
      "wording_ru": "Форма строится послойно из цифровой геометрии, меняя роль оснастки и серийности. Тема рассматривается как система отношений между данными, инструментом, человеком и результатом, а не как название отдельной программы или машины.",
      "confidence_score": 0.72,
      "verification_state": "attributed"
    },
    {
      "id": "clm_3d-printing-production-without-traditional-tooling_origin",
      "wording_ru": "Современное аддитивное производство сформировалось в 1980-х вокруг быстрого прототипирования. Стереолитография Чарльза Халла, закреплённая патентом 1986 года, стала одной из ключевых ранних технологий; позже отрасль перешла от прототипов к конечным деталям и стандартам.",
      "confidence_score": 0.72,
      "verification_state": "attributed"
    },
    {
      "id": "clm_3d-printing-production-without-traditional-tooling_method",
      "wording_ru": "Модель ориентируют и разбивают на слои; машина формирует их экструзией, фотополимеризацией, спеканием, плавлением или другим способом. Ориентация, поддержки и толщина слоя влияют на поверхность, прочность и время. Принципиально важно отделять цифровое описание от физического или визуального результа",
      "confidence_score": 0.72,
      "verification_state": "attributed"
    },
    {
      "id": "clm_3d-printing-production-without-traditional-tooling_case1",
      "wording_ru": "Стереолитография — послойное отверждение фотополимера. Этот пример важен как демонстрация базового принципа, а не только как историческая веха.",
      "confidence_score": 0.72,
      "verification_state": "attributed"
    },
    {
      "id": "clm_3d-printing-production-without-traditional-tooling_impact",
      "wording_ru": "Тема изменила дисциплину тем, что перераспределила решения между человеком, данными, программой, машиной и материалом. Форма строится послойно из цифровой геометрии, меняя роль оснастки и серийности.",
      "confidence_score": 0.72,
      "verification_state": "attributed"
    },
    {
      "id": "clm_3d-printing-production-without-traditional-tooling_today",
      "wording_ru": "Аддитивное производство движется к сертифицированным конечным деталям, медицине, оснастке и крупному формату, а стандартизация и метрология стремятся обеспечить повторяемость между машинами и партиями.",
      "confidence_score": 0.72,
      "verification_state": "attributed"
    },
    {
