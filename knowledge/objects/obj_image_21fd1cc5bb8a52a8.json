  "claims": [
    {
      "id": "clm_color-grading-color-as-autho_def",
      "wording_ru": "Цветокоррекция и градация — процессы технического согласования и творческого формирования цвета. Они соединяют камеру, пространство цвета, монитор, мастер-файл и конкретный способ показа.",
      "confidence_score": 0.72,
      "verification_state": "attributed"
    },
    {
      "id": "clm_color-grading-color-as-autho_orig",
      "wording_ru": "Фотохимическая печать давно требовала управления плотностью и цветовым балансом; цифровой intermediate и стандартизированные цветовые системы перенесли эту задачу в программный конвейер.",
      "confidence_score": 0.72,
      "verification_state": "attributed"
    },
    {
      "id": "clm_color-grading-color-as-autho_form",
      "wording_ru": "Материал изображения включает носитель, оптику или исходный файл, свет, поверхность воспроизведения и метаданные; форма зависит от всей цепочки, а не только от момента съёмки. Инфраструктура включает профили/цветовые пространства, калиброванный монитор, контроль освещения, scopes, метаданные и согла",
      "confidence_score": 0.72,
      "verification_state": "attributed"
    },
    {
      "id": "clm_color-grading-color-as-autho_use",
      "wording_ru": "Сначала изображение приводится к предсказуемому техническому состоянию, затем формируется творческий цветовой образ; преобразования для монитора, печати, SDR/HDR и архива должны быть отделены от самого мастер-изображения.",
      "confidence_score": 0.72,
      "verification_state": "attributed"
    },
    {
      "id": "clm_color-grading-color-as-autho_impact",
      "wording_ru": "Главное изменение для дисциплины — превращение изображения из единичного кадра в управляемую систему решений, версий, носителей и связей. захват → преобразование → баланс → цветовой образ → эталонный файл → output transform",
      "confidence_score": 0.72,
      "verification_state": "attributed"
    },
    {
      "id": "clm_color-grading-color-as-autho_today",
      "wording_ru": "Сегодня тему следует читать как цепочку: захват → преобразование → баланс → цветовой образ → эталонный файл → output transform. Финальное изображение — видимая поверхность большого производственного процесса.",
      "confidence_score": 0.72,
      "verification_state": "attributed"
    }
  ],
