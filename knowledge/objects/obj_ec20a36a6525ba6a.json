        }
      ]
    },
    {
      "id": "clm_d853a1d013be907f",
      "wording_ru": "С 1962 года преподавал архитектуру в Принстонском университете, одновременно ведя частную практику.",
      "claim_type": "attribution",
      "material": true,
      "verification_state": "verified",
      "confidence_score": 0.88,
      "evidence": [
        {
          "source_url": "https://www.britannica.com/biography/Michael-Graves",
