      ]
    },
    {
      "id": "clm_c76a2b34014598cc",
      "wording_ru": "Изучал архитектуру в Университете Цинциннати (бакалавр, 1958) и в Гарвардском университете (магистр, 1959), а затем, как лауреат Prix de Rome, учился в Американской академии в Риме (1960-1962).",
      "claim_type": "attribution",
      "material": true,
      "verification_state": "verified",
      "confidence_score": 0.9,
      "evidence": [
        {
          "source_url": "https://www.britannica.com/biography/Michael-Graves",
