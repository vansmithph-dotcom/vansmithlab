  "claims": [
    {
      "id": "clm_mezzadro-stool_def",
      "wording_ru": "Mezzadro — табурет Акилле и Пьера Джакомо Кастильони, спроектированный в 1957 году и запущенный Zanotta в производство в 1970-м. Его металлическое сиденье происходит от сельскохозяйственного трактора и соединено с пружинящей стальной опорой и деревянной базой.",
      "confidence_score": 0.72,
      "verification_state": "attributed"
    },
    {
      "id": "clm_mezzadro-stool_origin",
      "wording_ru": "Братья Кастильони исследовали готовые промышленные компоненты как строительный материал для нового предмета. Проект переносил элемент сельскохозяйственной машины в интерьер без попытки скрыть его происхождение.",
      "confidence_score": 0.72,
      "verification_state": "attributed"
    },
    {
      "id": "clm_mezzadro-stool_form",
      "wording_ru": "Четыре ясно различимые части сохраняют собственную идентичность: штампованное тракторное сиденье, хромированная стальная полоса, соединительный крепёж и деревянная поперечина-основание. Предмет строится на новом отношении между готовыми деталями.",
      "confidence_score": 0.72,
      "verification_state": "attributed"
    },
    {
      "id": "clm_mezzadro-stool_use",
      "wording_ru": "Четыре ясно различимые части сохраняют собственную идентичность: штампованное тракторное сиденье, хромированная стальная полоса, соединительный крепёж и деревянная поперечина-основание. Предмет строится на новом отношении между готовыми деталями. Пользование нельзя отделить от устройства: то, как че",
      "confidence_score": 0.72,
      "verification_state": "attributed"
    },
    {
      "id": "clm_mezzadro-stool_impact",
      "wording_ru": "Mezzadro переносит логику готового найденного элемента в промышленный дизайн, но не является просто найденным объектом. Дизайнеры меняют контекст, опору, высоту, баланс и способ использования — проектируют отношения между существующими вещами. Главный вклад предмета — изменение постановки задачи: по",
      "confidence_score": 0.72,
      "verification_state": "attributed"
    },
    {
      "id": "clm_mezzadro-stool_today",
      "wording_ru": "Сегодня Mezzadro стоит читать в трёх масштабах: как вещь для тела, как производственную систему и как изображение, нагруженное историей. Символическая сила тракторного сиденья может затмить реальную работу конструкции. После включения в музейный и премиальный рынок жест экономии и присвоения массово",
      "confidence_score": 0.72,
      "verification_state": "attributed"
    },
    {
      "id": "clm_mezzadro-stool_tl_1957",
      "wording_ru": "Mezzadro проектируется в рамках экспериментов с современной домашней средой (1957)",
      "confidence_score": 0.72,
      "verification_state": "attributed",
      "date_start": "1957-01-01"
    },
