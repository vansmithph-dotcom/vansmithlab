    {
      "id": "clm_e183d48a7d694faa",
      "wording_ru": "Чарльз Корреа родился 1 сентября 1930 года в Секундерабаде, Британская Индия, в семье гоанских католиков.",
      "claim_type": "attribution",
      "material": true,
      "verification_state": "verified",
