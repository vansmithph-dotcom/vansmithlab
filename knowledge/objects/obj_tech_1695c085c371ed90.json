  "claims": [
    {
      "id": "clm_laser-cutting-flat-precision-serial-form_def",
      "wording_ru": "Двухмерный контур становится резом, а лист — системой деталей, соединений и модулей. Тема рассматривается как система отношений между данными, инструментом, человеком и результатом, а не как название отдельной программы или машины.",
      "confidence_score": 0.72,
      "verification_state": "attributed"
    },
    {
      "id": "clm_laser-cutting-flat-precision-serial-form_origin",
      "wording_ru": "Промышленная лазерная обработка развивалась вместе с мощными источниками и системами управления движением. Распространение CAD/CAM позволило менять геометрию без отдельного штампа, что сделало технологию особенно полезной для прототипов и малых серий.",
      "confidence_score": 0.72,
      "verification_state": "attributed"
    },
    {
      "id": "clm_laser-cutting-flat-precision-serial-form_method",
      "wording_ru": "Сфокусированный луч локально нагревает материал, а газ и движение режущей головки формируют линию реза. Качество зависит от мощности, фокуса, скорости, толщины, материала, газа и последовательности траектории. Принципиально важно отделять цифровое описание от физического или визуального результата: ",
      "confidence_score": 0.72,
      "verification_state": "attributed"
    },
    {
      "id": "clm_laser-cutting-flat-precision-serial-form_case1",
      "wording_ru": "Металлическая деталь — связь контура, ширины реза и гибки. Этот пример важен как демонстрация базового принципа, а не только как историческая веха.",
      "confidence_score": 0.72,
      "verification_state": "attributed"
    },
    {
      "id": "clm_laser-cutting-flat-precision-serial-form_impact",
      "wording_ru": "Тема изменила дисциплину тем, что перераспределила решения между человеком, данными, программой, машиной и материалом. Двухмерный контур становится резом, а лист — системой деталей, соединений и модулей.",
      "confidence_score": 0.72,
      "verification_state": "attributed"
    },
    {
      "id": "clm_laser-cutting-flat-precision-serial-form_today",
      "wording_ru": "Современные системы повышают скорость, автоматизацию и мониторинг, но проектная логика остаётся прежней: геометрия, материал, ширина реза и последующая сборка должны рассматриваться вместе.",
      "confidence_score": 0.72,
      "verification_state": "attributed"
    }
  ],
