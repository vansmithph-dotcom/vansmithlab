        }
      ]
    },
    {
      "id": "clm_0125f2d5b95aedb4",
      "wording_ru": "24 февраля 1912 года его мать утонула в реке Самбр в Шательте; после этой трагедии Магритт находил утешение в кино, романах и, прежде всего, в живописи.",
      "claim_type": "attribution",
      "material": true,
      "verification_state": "verified",
      "confidence_score": 0.87,
      "evidence": [
        {
          "source_url": "https://www.britannica.com/biography/Rene-Magritte",
