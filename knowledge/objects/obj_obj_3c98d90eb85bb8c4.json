  "claims": [
    {
      "id": "clm_606-universal-shelving-system_def",
      "wording_ru": "606 Universal Shelving System — модульная система хранения, спроектированная Дитером Рамсом в 1960 году для Vitsœ. Вместо законченного шкафа пользователь получает инфраструктуру: направляющие, полки, шкафчики, столы и крепёж, которые можно собирать, переставлять и расширять.",
      "confidence_score": 0.72,
      "verification_state": "attributed"
    },
    {
      "id": "clm_606-universal-shelving-system_origin",
      "wording_ru": "Система возникла в контексте послевоенного системного дизайна, где вещь рассматривалась как изменяемая структура, а не одноразовая композиция. Рамс и Vitsœ сделали длительность и адаптацию центральной частью продукта задолго до нынешней риторики циркулярности.",
      "confidence_score": 0.72,
      "verification_state": "attributed"
    },
    {
      "id": "clm_606-universal-shelving-system_form",
      "wording_ru": "Ядро системы — алюминиевые направляющие, к которым подвешиваются полки, шкафы и рабочие поверхности. Несущая инфраструктура остаётся визуально скромной, чтобы разные конфигурации выглядели как одна система.",
      "confidence_score": 0.72,
      "verification_state": "attributed"
    },
    {
      "id": "clm_606-universal-shelving-system_use",
      "wording_ru": "Ядро системы — алюминиевые направляющие, к которым подвешиваются полки, шкафы и рабочие поверхности. Несущая инфраструктура остаётся визуально скромной, чтобы разные конфигурации выглядели как одна система. Пользование нельзя отделить от устройства: то, как человек садится, двигает, переносит или пе",
      "confidence_score": 0.72,
      "verification_state": "attributed"
    },
    {
      "id": "clm_606-universal-shelving-system_impact",
      "wording_ru": "606 переводит дизайн из формы в правила. Пользователь покупает не окончательную композицию, а грамматику, которая может отвечать на переезд, рост библиотеки, смену комнаты или функции. Главный вклад предмета — изменение постановки задачи: после него дизайнеры получили новый пример связи тела, матери",
      "confidence_score": 0.72,
      "verification_state": "attributed"
    },
    {
      "id": "clm_606-universal-shelving-system_today",
      "wording_ru": "Сегодня 606 Universal Shelving System стоит читать в трёх масштабах: как вещь для тела, как производственную систему и как изображение, нагруженное историей. Системность требует дисциплины: инфраструктура, планирование и оригинальные компоненты создают зависимость от производителя. Высокая первонача",
      "confidence_score": 0.72,
      "verification_state": "attributed"
    },
    {
      "id": "clm_606-universal-shelving-system_tl_1960",
      "wording_ru": "Dieter Rams проектирует 606 Universal Shelving System (1960)",
      "confidence_score": 0.72,
