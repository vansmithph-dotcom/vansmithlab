  "claims": [
    {
      "id": "clm_storyboard-image-before-imag_def",
      "wording_ru": "Раскадровка — визуальный план последовательности будущих кадров. Она переводит текст, идею или действие в серию изображений, где можно заранее проверить композицию, направление взгляда, движение камеры и монтаж.",
      "confidence_score": 0.72,
      "verification_state": "attributed"
    },
    {
      "id": "clm_storyboard-image-before-imag_orig",
      "wording_ru": "До кино существовали последовательные рисунки и иллюстративные планы; в индустриальном кинопроизводстве раскадровка становится инструментом координации режиссуры, камеры, постановки, анимации и визуальные эффекты.",
      "confidence_score": 0.72,
      "verification_state": "attributed"
    },
    {
      "id": "clm_storyboard-image-before-imag_form",
      "wording_ru": "Материал изображения включает носитель, оптику или исходный файл, свет, поверхность воспроизведения и метаданные; форма зависит от всей цепочки, а не только от момента съёмки. Раскадровка экономит дорогие изменения на площадке и служит общим визуальным языком между отделами.",
      "confidence_score": 0.72,
      "verification_state": "attributed"
    },
    {
      "id": "clm_storyboard-image-before-imag_use",
      "wording_ru": "Сцена разбивается на ключевые моменты; каждый кадр фиксирует масштаб, направление действия и важные элементы, а подписи могут указывать движение, звук или переход.",
      "confidence_score": 0.72,
      "verification_state": "attributed"
    },
    {
      "id": "clm_storyboard-image-before-imag_impact",
      "wording_ru": "Главное изменение для дисциплины — превращение изображения из единичного кадра в управляемую систему решений, версий, носителей и связей. сценарий → кадры → последовательность → аниматик/предварительная визуализация → съёмка → монтаж",
      "confidence_score": 0.72,
      "verification_state": "attributed"
    },
    {
      "id": "clm_storyboard-image-before-imag_today",
      "wording_ru": "Сегодня тему следует читать как цепочку: сценарий → кадры → последовательность → аниматик/предварительная визуализация → съёмка → монтаж. Финальное изображение — видимая поверхность большого производственного процесса.",
      "confidence_score": 0.72,
      "verification_state": "attributed"
    }
  ],
