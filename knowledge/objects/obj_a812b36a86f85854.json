        }
      ],
      "date_start": "1936",
      "date_end": null,
      "date_precision": "year"
    },
    {
      "id": "clm_d52f2297c6559af3",
      "wording_ru": "Отец познакомил его с архитектурой Людвига Мис ван дер Роэ и философией Генри Дэвида Торо — оба этих влияния определили его дальнейший метод.",
      "claim_type": "attribution",
      "material": true,
      "verification_state": "verified",
      "confidence_score": 0.87,
      "evidence": [
        {
          "source_url": "https://www.pritzkerprize.com/biography-glenn-murcutt",
          "locator": "см. источник",
          "support": "Подтверждает утверждение"
        }
      ]
    },
    {
      "id": "clm_0ae479a8c5cb44cc",
      "wording_ru": "Окончил University of New South Wales в 1961 году со степенью по архитектуре, а с 1964 года пять лет работал в бюро Ancher, Mortlock, Murray and Woolley в Сиднее.",
      "claim_type": "attribution",
      "material": true,
      "verification_state": "verified",
      "confidence_score": 0.89,
      "evidence": [
        {
          "source_url": "https://www.pritzkerprize.com/biography-glenn-murcutt",
