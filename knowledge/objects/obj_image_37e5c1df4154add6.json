  "claims": [
    {
      "id": "clm_contact-sheet-photography-as_def",
      "wording_ru": "Контактный лист — физический или цифровой интерфейс отбора, показывающий последовательность съёмки и отношения между соседними кадрами. Он переводит фотографию из акта экспонирования в процесс редактирования.",
      "confidence_score": 0.72,
      "verification_state": "attributed"
    },
    {
      "id": "clm_contact-sheet-photography-as_orig",
      "wording_ru": "В плёночной практике полосы негативов контактно печатались на бумаге, чтобы быстро увидеть весь ролик. Журнальные архивы сохранили листы с отметками редакторов и фотографов, позволяющие восстановить логику выбора.",
      "confidence_score": 0.72,
      "verification_state": "attributed"
    },
    {
      "id": "clm_contact-sheet-photography-as_form",
      "wording_ru": "Материал изображения включает носитель, оптику или исходный файл, свет, поверхность воспроизведения и метаданные; форма зависит от всей цепочки, а не только от момента съёмки. Контактный лист требует сохранения номера кадра, порядка и связи с исходным негативом/файлом; иначе он превращается в красив",
      "confidence_score": 0.72,
      "verification_state": "attributed"
    },
    {
      "id": "clm_contact-sheet-photography-as_use",
      "wording_ru": "Негативы или миниатюры располагаются в последовательности; автор и редактор сравнивают жест, резкость, композицию и смысл, маркируют кандидатов и переходят к рабочим отпечаткам или финальным файлам.",
      "confidence_score": 0.72,
      "verification_state": "attributed"
    },
    {
      "id": "clm_contact-sheet-photography-as_impact",
      "wording_ru": "Главное изменение для дисциплины — превращение изображения из единичного кадра в управляемую систему решений, версий, носителей и связей. съёмка → последовательность → сравнение → отметка → выбор → публикация",
      "confidence_score": 0.72,
      "verification_state": "attributed"
    },
    {
      "id": "clm_contact-sheet-photography-as_today",
      "wording_ru": "Сегодня тему следует читать как цепочку: съёмка → последовательность → сравнение → отметка → выбор → публикация. Финальное изображение — видимая поверхность большого производственного процесса.",
      "confidence_score": 0.72,
      "verification_state": "attributed"
    }
  ],
