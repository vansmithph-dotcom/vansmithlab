  "claims": [
    {
      "id": "clm_motion-design-graphic-design_def",
      "wording_ru": "Моушн-дизайн применяет принципы графического дизайна к временной последовательности. Его основные материалы — типографика, форма, изображение, цвет, ритм, звук и переход между состояниями.",
      "confidence_score": 0.72,
      "verification_state": "attributed"
    },
    {
      "id": "clm_motion-design-graphic-design_orig",
      "wording_ru": "Кинотитры, телевизионная графика и экспериментальная анимация сформировали поле до цифровых программ; desktop композитинг и After Effects сделали временную графику массовой профессиональной практикой.",
      "confidence_score": 0.72,
      "verification_state": "attributed"
    },
    {
      "id": "clm_motion-design-graphic-design_form",
      "wording_ru": "Материал изображения включает носитель, оптику или исходный файл, свет, поверхность воспроизведения и метаданные; форма зависит от всей цепочки, а не только от момента съёмки. Производство требует раскадровка/animatic, материалы, композиции, тайминга, рендера, кодеков, версий и контроля цвета.",
      "confidence_score": 0.72,
      "verification_state": "attributed"
    },
    {
      "id": "clm_motion-design-graphic-design_use",
      "wording_ru": "Дизайнер задаёт ключевые состояния и временные отношения, строит иерархию движения, использует easing, маски, слои, камеры и композиции, а затем адаптирует результат под разные форматы.",
      "confidence_score": 0.72,
      "verification_state": "attributed"
    },
    {
      "id": "clm_motion-design-graphic-design_impact",
      "wording_ru": "Главное изменение для дисциплины — превращение изображения из единичного кадра в управляемую систему решений, версий, носителей и связей. графическая система → состояния → тайминг → движение → звук → версия/экран",
      "confidence_score": 0.72,
      "verification_state": "attributed"
    },
    {
      "id": "clm_motion-design-graphic-design_today",
      "wording_ru": "Сегодня тему следует читать как цепочку: графическая система → состояния → тайминг → движение → звук → версия/экран. Финальное изображение — видимая поверхность большого производственного процесса.",
      "confidence_score": 0.72,
      "verification_state": "attributed"
    }
  ],
