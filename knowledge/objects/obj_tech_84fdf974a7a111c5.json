  "claims": [
    {
      "id": "clm_adobe-photoshop-layer-mask-editable-image_def",
      "wording_ru": "Изображение стало слоистым документом, где решения можно разделять, маскировать и пересобирать. Тема рассматривается как система отношений между данными, инструментом, человеком и результатом, а не как название отдельной программы или машины.",
      "confidence_score": 0.72,
      "verification_state": "attributed"
    },
    {
      "id": "clm_adobe-photoshop-layer-mask-editable-image_origin",
      "wording_ru": "Photoshop вырос из работы Томаса Нолла и совместной разработки с Джоном Ноллом; Adobe выпустила первую версию для Macintosh в 1990 году. Слои появились в версии 3.0 в 1994 году, а Camera Raw связал программу с цифровой фотографией.",
      "confidence_score": 0.72,
      "verification_state": "attributed"
    },
    {
      "id": "clm_adobe-photoshop-layer-mask-editable-image_method",
      "wording_ru": "Документ объединяет пиксельные слои, маски, корректировки, каналы, выделения и цвет. Маска отделяет видимость от удаления, а слои делают многие операции обратимыми. Принципиально важно отделять цифровое описание от физического или визуального результата: между ними всегда существует цепочка интерпре",
      "confidence_score": 0.72,
      "verification_state": "attributed"
    },
    {
      "id": "clm_adobe-photoshop-layer-mask-editable-image_case1",
      "wording_ru": "Слои — модульный композитинг. Этот пример важен как демонстрация базового принципа, а не только как историческая веха.",
      "confidence_score": 0.72,
      "verification_state": "attributed"
    },
    {
      "id": "clm_adobe-photoshop-layer-mask-editable-image_impact",
      "wording_ru": "Тема изменила дисциплину тем, что перераспределила решения между человеком, данными, программой, машиной и материалом. Изображение стало слоистым документом, где решения можно разделять, маскировать и пересобирать.",
      "confidence_score": 0.72,
      "verification_state": "attributed"
    },
    {
      "id": "clm_adobe-photoshop-layer-mask-editable-image_today",
      "wording_ru": "Photoshop остаётся узлом фотографии, рекламы, издательства, CGI и генеративных систем; культурно важен сам принцип управляемой изменяемости изображения.",
      "confidence_score": 0.72,
      "verification_state": "attributed"
    },
