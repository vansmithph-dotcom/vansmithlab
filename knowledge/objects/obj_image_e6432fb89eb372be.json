  "claims": [
    {
      "id": "clm_magazine-cover-image-as-issu_def",
      "wording_ru": "Обложка журнала — интерфейс между редакционным содержанием, брендом издания, киоском/экраном и памятью читателя. Она работает как обещание того, что находится внутри, и как самостоятельный культурный объект.",
      "confidence_score": 0.72,
      "verification_state": "attributed"
    },
    {
      "id": "clm_magazine-cover-image-as-issu_orig",
      "wording_ru": "От иллюстрированных обложек к фотографическим лицам и радикальным типографическим решениям XX века журнал постоянно менял баланс между узнаваемой системой и уникальностью конкретного номера.",
      "confidence_score": 0.72,
      "verification_state": "attributed"
    },
    {
      "id": "clm_magazine-cover-image-as-issu_form",
      "wording_ru": "Материал изображения включает носитель, оптику или исходный файл, свет, поверхность воспроизведения и метаданные; форма зависит от всей цепочки, а не только от момента съёмки. Обложка требует фотографии/иллюстрации, типографики, сетки, цветовой системы, производственных спецификаций печати и адаптац",
      "confidence_score": 0.72,
      "verification_state": "attributed"
    },
    {
      "id": "clm_magazine-cover-image-as-issu_use",
      "wording_ru": "Редакция выбирает главный образ, определяет crop, иерархию логотипа и cover lines, тестирует читаемость в физическом и цифровом масштабе и согласует коммерческие ограничения.",
      "confidence_score": 0.72,
      "verification_state": "attributed"
    },
    {
      "id": "clm_magazine-cover-image-as-issu_impact",
      "wording_ru": "Главное изменение для дисциплины — превращение изображения из единичного кадра в управляемую систему решений, версий, носителей и связей. редакционный тезис → главное изображение → типографика → иерархия → выпуск → архив",
      "confidence_score": 0.72,
      "verification_state": "attributed"
    },
    {
      "id": "clm_magazine-cover-image-as-issu_today",
      "wording_ru": "Сегодня тему следует читать как цепочку: редакционный тезис → главное изображение → типографика → иерархия → выпуск → архив. Финальное изображение — видимая поверхность большого производственного процесса.",
      "confidence_score": 0.72,
      "verification_state": "attributed"
    }
  ],
