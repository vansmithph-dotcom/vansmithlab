  "claims": [
    {
      "id": "clm_photobook-sequence-instead-o_def",
      "wording_ru": "Фотокнига — издание, в котором фотографический смысл строится через последовательность изображений и материальную форму книги. Отдельный кадр здесь подчинён монтажу, ритму и отношениям с соседними страницами.",
      "confidence_score": 0.72,
      "verification_state": "attributed"
    },
    {
      "id": "clm_photobook-sequence-instead-o_orig",
      "wording_ru": "Фотографы собирают изображения в книги почти с момента возникновения фотографии; в XX веке фотокнига становится самостоятельным авторским медиумом, а в XXI — важным полем коллекционирования и кураторства.",
      "confidence_score": 0.72,
      "verification_state": "attributed"
    },
    {
      "id": "clm_photobook-sequence-instead-o_form",
      "wording_ru": "Материал изображения включает носитель, оптику или исходный файл, свет, поверхность воспроизведения и метаданные; форма зависит от всей цепочки, а не только от момента съёмки. Производство соединяет файлы/негативы, цветопробу, верстку, бумагу, печать, переплёт, тираж, дистрибуцию и архив.",
      "confidence_score": 0.72,
      "verification_state": "attributed"
    },
    {
      "id": "clm_photobook-sequence-instead-o_use",
      "wording_ru": "Автор/редактор создаёт edit, последовательность и группы изображений; дизайнер определяет формат, бумагу, типографику, binding и темп; печатный proof проверяет, как фотографии работают как физический объект.",
      "confidence_score": 0.72,
      "verification_state": "attributed"
    },
    {
      "id": "clm_photobook-sequence-instead-o_impact",
      "wording_ru": "Главное изменение для дисциплины — превращение изображения из единичного кадра в управляемую систему решений, версий, носителей и связей. серия → edit → последовательность → макет → печать → переплёт → чтение",
      "confidence_score": 0.72,
      "verification_state": "attributed"
    },
    {
      "id": "clm_photobook-sequence-instead-o_today",
      "wording_ru": "Сегодня тему следует читать как цепочку: серия → edit → последовательность → макет → печать → переплёт → чтение. Финальное изображение — видимая поверхность большого производственного процесса.",
      "confidence_score": 0.72,
      "verification_state": "attributed"
    }
  ],
