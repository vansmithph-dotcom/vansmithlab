  "claims": [
    {
      "id": "clm_advertising-photography-imag_def",
      "wording_ru": "Рекламная фотография — изображение с заранее заданной коммерческой функцией. Она связывает свойства продукта с желанием, образом жизни или узнаваемостью и потому тесно зависит от брифа, бренда, медиаплана и юридических ограничений.",
      "confidence_score": 0.72,
      "verification_state": "attributed"
    },
    {
      "id": "clm_advertising-photography-imag_orig",
      "wording_ru": "В начале XX века фотография постепенно вытесняет часть иллюстрации в рекламе; к 1930-м камера становится одним из основных инструментов печатной коммерческой коммуникации, а арт-директора активно используют постановку и манипуляцию.",
      "confidence_score": 0.72,
      "verification_state": "attributed"
    },
    {
      "id": "clm_advertising-photography-imag_form",
      "wording_ru": "Материал изображения включает носитель, оптику или исходный файл, свет, поверхность воспроизведения и метаданные; форма зависит от всей цепочки, а не только от момента съёмки. Производство включает клиента, агентство, креативную и арт-дирекцию, фотографа, продюсера, стилиста, постпродакшн и цепочку ",
      "confidence_score": 0.72,
      "verification_state": "attributed"
    },
    {
      "id": "clm_advertising-photography-imag_use",
      "wording_ru": "Бриф определяет аудиторию, сообщение, обязательные элементы и носители; затем создаются концепт, раскадровка/макет, съёмка, композитинг, ретушь, версии и адаптации.",
      "confidence_score": 0.72,
      "verification_state": "attributed"
    },
    {
      "id": "clm_advertising-photography-imag_impact",
      "wording_ru": "Главное изменение для дисциплины — превращение изображения из единичного кадра в управляемую систему решений, версий, носителей и связей. бренд → бриф → концепт → производство → постпродакшн → версии → медиаразмещение",
      "confidence_score": 0.72,
      "verification_state": "attributed"
    },
    {
      "id": "clm_advertising-photography-imag_today",
      "wording_ru": "Сегодня тему следует читать как цепочку: бренд → бриф → концепт → производство → постпродакшн → версии → медиаразмещение. Финальное изображение — видимая поверхность большого производственного процесса.",
      "confidence_score": 0.72,
      "verification_state": "attributed"
    }
  ],
