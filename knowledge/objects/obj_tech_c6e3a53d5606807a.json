  "claims": [
    {
      "id": "clm_generative-design-form-through-constraints-and-variants_def",
      "wording_ru": "Дизайнер задаёт цели и границы, а система исследует пространство допустимых решений. Тема рассматривается как система отношений между данными, инструментом, человеком и результатом, а не как название отдельной программы или машины.",
      "confidence_score": 0.72,
      "verification_state": "attributed"
    },
    {
      "id": "clm_generative-design-form-through-constraints-and-variants_origin",
      "wording_ru": "Подход вырос из вычислительного проектирования, оптимизации и параметрических систем. Он стал заметнее, когда CAD-платформы получили интегрированные солверы и вычислительные ресурсы для массового исследования вариантов; Project Discover показал такую логику на планировке офиса.",
      "confidence_score": 0.72,
      "verification_state": "attributed"
    },
    {
      "id": "clm_generative-design-form-through-constraints-and-variants_method",
      "wording_ru": "Процесс начинается с параметров, целей, ограничений и критериев. Алгоритм создаёт варианты, оценивает их и формирует пространство результатов; дизайнер меняет постановку и критически выбирает решения. Принципиально важно отделять цифровое описание от физического или визуального результата: между ним",
      "confidence_score": 0.72,
      "verification_state": "attributed"
    },
    {
      "id": "clm_generative-design-form-through-constraints-and-variants_case1",
      "wording_ru": "Project Discover — многокритериальные планировки. Этот пример важен как демонстрация базового принципа, а не только как историческая веха.",
      "confidence_score": 0.72,
      "verification_state": "attributed"
    },
    {
      "id": "clm_generative-design-form-through-constraints-and-variants_impact",
      "wording_ru": "Тема изменила дисциплину тем, что перераспределила решения между человеком, данными, программой, машиной и материалом. Дизайнер задаёт цели и границы, а система исследует пространство допустимых решений.",
      "confidence_score": 0.72,
      "verification_state": "attributed"
    },
    {
      "id": "clm_generative-design-form-through-constraints-and-variants_today",
      "wording_ru": "Порождающее проектирование сближается с машинным обучением, симуляцией и автоматизированной проверкой; главный вопрос — насколько осмысленно определено пространство поиска.",
      "confidence_score": 0.72,
      "verification_state": "attributed"
    }
  ],
