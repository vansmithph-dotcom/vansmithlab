  "claims": [
    {
      "id": "clm_853b5de50e74ca69",
      "wording_ru": "Кит Харинг родился 4 мая 1958 года в Ридинге, Пенсильвания, и вырос в соседнем Кутстауне; рисовать начал рано, перенимая базовые навыки мультипликации у отца и массовой культуры вроде доктора Сьюза и Уолта Диснея.",
      "claim_type": "attribution",
      "material": true,
      "verification_state": "verified",
      "confidence_score": 0.89,
      "evidence": [
        {
          "source_url": "https://pabook.libraries.psu.edu/literary-cultural-heritage-map-pa/bios/haring__keith",
          "locator": "см. источник",
          "support": "Подтверждает утверждение"
        }
      ]
    },
    {
      "id": "clm_f7d3a205bf26b3d6",
      "wording_ru": "После окончания школы в 1976 году поступил в Ivy School of Professional Art в Питтсбурге — коммерческую художественную школу, — но, поняв, что коммерческая графика ему не интересна, бросил учёбу после двух семестров.",
      "claim_type": "attribution",
      "material": true,
      "verification_state": "verified",
      "confidence_score": 0.87,
      "evidence": [
        {
          "source_url": "https://pabook.libraries.psu.edu/literary-cultural-heritage-map-pa/bios/haring__keith",
          "locator": "см. источник",
          "support": "Подтверждает утверждение"
        }
      ]
    },
    {
      "id": "clm_876fe3ca16f63673",
      "wording_ru": "Получил известность благодаря спонтанным рисункам белым мелом на неиспользуемых чёрных рекламных панелях в нью-йоркском метро — ползущие младенцы, лающие собаки, танцующие фигуры и другие анимированные символы, ставшие темой для разговоров у пассажиров.",
      "claim_type": "attribution",
      "material": true,
      "verification_state": "verified",
      "confidence_score": 0.9,
      "evidence": [
        {
          "source_url": "https://pabook.libraries.psu.edu/literary-cultural-heritage-map-pa/bios/haring__keith",
          "locator": "см. источник",
          "support": "Подтверждает утверждение"
        }
      ]
    },
    {
      "id": "clm_c2f1a1ac9d0c1984",
      "wording_ru": "С 1982 по 1989 год создал более 50 общественных муралей, многие — безвозмездно для больниц, школ и общественных пространств.",
