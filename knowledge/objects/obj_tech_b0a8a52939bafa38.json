  "claims": [
    {
      "id": "clm_cad-from-drawing-board-to-digital-model_def",
      "wording_ru": "Чертёж стал изменяемой геометрией, а проект — системой связанных данных. Тема рассматривается как система отношений между данными, инструментом, человеком и результатом, а не как название отдельной программы или машины.",
      "confidence_score": 0.72,
      "verification_state": "attributed"
    },
    {
      "id": "clm_cad-from-drawing-board-to-digital-model_origin",
      "wording_ru": "Ранние интерактивные графические системы 1960-х показали, что геометрией можно управлять на экране. Sketchpad Ивана Сазерленда, представленный в диссертации MIT в 1963 году, стал ключевым прототипом; AutoCAD 1982 года символизировал переход CAD на персональный компьютер.",
      "confidence_score": 0.72,
      "verification_state": "attributed"
    },
    {
      "id": "clm_cad-from-drawing-board-to-digital-model_method",
      "wording_ru": "CAD хранит координаты, кривые, поверхности, тела, размеры, зависимости и параметры. Изменение модели может пересчитать виды и подготовить данные для спецификаций, CAM и производства. Принципиально важно отделять цифровое описание от физического или визуального результата: между ними всегда существуе",
      "confidence_score": 0.72,
      "verification_state": "attributed"
    },
    {
      "id": "clm_cad-from-drawing-board-to-digital-model_case1",
      "wording_ru": "Sketchpad — интерактивная геометрия и связанные экземпляры. Этот пример важен как демонстрация базового принципа, а не только как историческая веха.",
      "confidence_score": 0.72,
      "verification_state": "attributed"
    },
    {
      "id": "clm_cad-from-drawing-board-to-digital-model_impact",
      "wording_ru": "Тема изменила дисциплину тем, что перераспределила решения между человеком, данными, программой, машиной и материалом. Чертёж стал изменяемой геометрией, а проект — системой связанных данных.",
      "confidence_score": 0.72,
      "verification_state": "attributed"
    },
    {
      "id": "clm_cad-from-drawing-board-to-digital-model_today",
      "wording_ru": "Сегодня CAD связан с BIM, параметрическим моделированием, облачным сотрудничеством, CAM и вычислительным проектированием; важна модель как носитель решений, а не сам факт цифрового чертежа.",
      "confidence_score": 0.72,
      "verification_state": "attributed"
    },
    {
