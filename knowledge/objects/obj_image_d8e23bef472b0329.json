  "claims": [
    {
      "id": "clm_title-sequences-typography-i_def",
      "wording_ru": "Титры и title sequence — система текста, изображения, звука и времени, которая передаёт обязательную информацию и одновременно формирует вход в произведение.",
      "confidence_score": 0.72,
      "verification_state": "attributed"
    },
    {
      "id": "clm_title-sequences-typography-i_orig",
      "wording_ru": "Ранние кинотитры были прежде всего информационными карточками; в середине XX века дизайнеры, особенно Саул Басс, превратили открывающую последовательность в самостоятельный визуальный пролог.",
      "confidence_score": 0.72,
      "verification_state": "attributed"
    },
    {
      "id": "clm_title-sequences-typography-i_form",
      "wording_ru": "Материал изображения включает носитель, оптику или исходный файл, свет, поверхность воспроизведения и метаданные; форма зависит от всей цепочки, а не только от момента съёмки. Производство требует графического дизайна, анимации, монтажа, композитинга, музыкального/звукового тайминга и юридически точ",
      "confidence_score": 0.72,
      "verification_state": "attributed"
    },
    {
      "id": "clm_title-sequences-typography-i_use",
      "wording_ru": "Список имён и ролей переводится в иерархию; затем определяются типографика, композиция, длительность, движение, музыка и отношение к первому кадру фильма.",
      "confidence_score": 0.72,
      "verification_state": "attributed"
    },
    {
      "id": "clm_title-sequences-typography-i_impact",
      "wording_ru": "Главное изменение для дисциплины — превращение изображения из единичного кадра в управляемую систему решений, версий, носителей и связей. список титров → иерархия → типографика → движение → звук → вход в произведение",
      "confidence_score": 0.72,
      "verification_state": "attributed"
    },
    {
      "id": "clm_title-sequences-typography-i_today",
      "wording_ru": "Сегодня тему следует читать как цепочку: список титров → иерархия → типографика → движение → звук → вход в произведение. Финальное изображение — видимая поверхность большого производственного процесса.",
      "confidence_score": 0.72,
      "verification_state": "attributed"
    }
  ],
