  "created_at": "2026-08-08T00:00:00.000Z",
  "updated_at": "2026-08-08T00:00:00.000Z",
  "claims": [
    {
      "id": "clm_1b215bd4bcc7d849",
      "wording_ru": "Габриэль Шанель открыла шляпную мастерскую в 1909 году, а в 1910 году официально зарегистрировала бизнес «Chanel Modes» и открыла бутик на рю Камбон, 21 в Париже — адрес, который Дом официально указывает как год основания и который остаётся историческим центром компании по сей день.",
      "claim_type": "attribution",
      "material": true,
      "verification_state": "verified",
      "confidence_score": 0.91,
      "evidence": [
        {
          "source_url": "https://www.chanel.com/us/about-chanel/the-house-of-chanel/1920/",
          "locator": "см. источник",
          "support": "Подтверждает утверждение"
        },
        {
          "source_url": "https://en.wikipedia.org/wiki/Chanel",
          "locator": "см. источник",
          "support": "Подтверждает утверждение"
        }
      ]
    },
    {
      "id": "clm_21423bb6faba129e",
      "wording_ru": "5 мая 1921 года представлен парфюм Chanel № 5, созданный французско-русским парфюмером Эрнестом Бо.",
      "claim_type": "attribution",
      "material": true,
      "verification_state": "verified",
      "confidence_score": 0.92,
      "evidence": [
        {
          "source_url": "https://www.chanel.com/us/about-chanel/the-house-of-chanel/1920/",
          "locator": "см. источник",
          "support": "Подтверждает утверждение"
        },
        {
          "source_url": "https://en.wikipedia.org/wiki/Chanel",
          "locator": "см. источник",
          "support": "Подтверждает утверждение"
        }
      ]
    },
    {
      "id": "clm_4916c5540a80073f",
      "wording_ru": "В 1924 году Пьер Вертеймер и Теофиль Бадер учредили компанию Parfums Chanel для производства и распространения аромата: Вертеймеры получили 70% долей, Бадер — 20%, сама Шанель — 10% и роялти; эта структура на десятилетия определила собственность бизнеса и стала источником длительных судебных споров.",
      "claim_type": "attribution",
      "material": true,
      "verification_state": "verified",
      "confidence_score": 0.9,
      "evidence": [
        {
          "source_url": "https://wwd.com/fashion-news/fashion-features/feature/who-owns-chanel-1236702127/",
          "locator": "см. источник",
          "support": "Подтверждает утверждение"
        },
        {
          "source_url": "https://en.wikipedia.org/wiki/Chanel",
          "locator": "см. источник",
          "support": "Подтверждает утверждение"
        }
      ]
    },
    {
      "id": "clm_dc48ee86b53d6385",
      "wording_ru": "Во время немецкой оккупации Парижа Шанель жила в отеле «Ритц» и состояла в отношениях с офицером немецкой военной разведки (Абвер) Гансом Гюнтером фон Динклаге; она пыталась воспользоваться нацистскими «арийскими» законами, чтобы отстранить своих еврейских партнёров, братьев Вертеймер, от владения парфюмерным бизнесом, — попытка не удалась, поскольку контроль над компанией был заранее передан доверенному лицу неарийского происхождения.",
      "claim_type": "attribution",
      "material": true,
      "verification_state": "verified",
      "confidence_score": 0.89,
      "evidence": [
        {
          "source_url": "https://www.britannica.com/topic/Was-Coco-Chanel-a-Nazi-Spy",
          "locator": "см. источник",
          "support": "Подтверждает утверждение"
        }
      ]
    },
    {
      "id": "clm_30741fb64a2cb9ba",
      "wording_ru": "В 1954 году, после пятнадцатилетнего перерыва, Шанель вернулась в моду с твидовым костюмом — коллекцией, прохладно встреченной французской прессой, но с энтузиазмом принятой в США.",
      "claim_type": "attribution",
      "material": true,
      "verification_state": "verified",
      "confidence_score": 0.89,
      "evidence": [
        {
          "source_url": "https://www.chanel.com/us/about-chanel/the-house-of-chanel/1950/",
          "locator": "см. источник",
          "support": "Подтверждает утверждение"
        },
        {
          "source_url": "https://collections.vam.ac.uk/item/O143168/skirt-suit-chanel-coco/",
          "locator": "см. источник",
          "support": "Подтверждает утверждение"
        }
      ]
    },
    {
      "id": "clm_1bf5f972b51ae77a",
      "wording_ru": "Коко Шанель умерла 10 января 1971 года в своих апартаментах в отеле «Ритц» в Париже.",
      "claim_type": "attribution",
      "material": true,
      "verification_state": "verified",
      "confidence_score": 0.9,
      "evidence": [
        {
          "source_url": "https://en.wikipedia.org/wiki/Chanel",
          "locator": "см. источник",
          "support": "Подтверждает утверждение"
        }
      ]
    },
    {
      "id": "clm_eb63c1194e6c43eb",
      "wording_ru": "В 1983 году художественным руководителем Дома стал Карл Лагерфельд и оставался им до своей смерти в феврале 2019 года — 36 лет, за которые он сохранил ключевые коды Дома, но радикально расширил их визуальный и коммерческий язык.",
      "claim_type": "attribution",
      "material": true,
      "verification_state": "verified",
      "confidence_score": 0.9,
      "evidence": [
        {
          "source_url": "https://en.wikipedia.org/wiki/Chanel",
          "locator": "см. источник",
          "support": "Подтверждает утверждение"
        }
      ]
    },
    {
      "id": "clm_5dd8d1ea047b0145",
      "wording_ru": "12 декабря 2024 года Дом объявил о назначении Матьё Блази, ранее креативного директора Bottega Veneta, новым художественным руководителем модных направлений Chanel; он приступил к работе в 2025 году.",
      "claim_type": "attribution",
      "material": true,
      "verification_state": "verified",
      "confidence_score": 0.92,
      "evidence": [
        {
          "source_url": "https://www.cnn.com/2024/12/12/style/chanel-matthieu-blazy-new-artistic-director/index.html",
          "locator": "см. источник",
          "support": "Подтверждает утверждение"
        }
      ]
    },
    {
      "id": "clm_310363970d332f80",
      "wording_ru": "Chanel остаётся частной компанией, не котирующейся на бирже, контролируемой семьёй Вертеймер; с 2018 года штаб-квартира группы официально расположена в Лондоне, а с января 2022 года глобальным генеральным директором является Лина Наир.",
      "claim_type": "attribution",
      "material": true,
      "verification_state": "verified",
      "confidence_score": 0.89,
      "evidence": [
        {
          "source_url": "https://wwd.com/fashion-news/fashion-features/feature/who-owns-chanel-1236702127/",
          "locator": "см. источник",
          "support": "Подтверждает утверждение"
