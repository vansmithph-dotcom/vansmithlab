      "verification_state": "attributed"
    },
    {
      "id": "clm_photop1_4f33cbf03120fe81_first",
      "wording_ru": "Без тени предмет становится схемой. С тенью он получает вес.",
      "wording_en": "Without shadow an object becomes a diagram. With shadow it gains weight.",
      "confidence_score": 0.74,
      "verification_state": "attributed"
    },
    {
      "id": "clm_photop1_4f33cbf03120fe81_last",
      "wording_ru": "Фотограф, который умеет видеть тень, управляет не только светом, но и тишиной изображения.",
      "wording_en": "A photographer who sees shadow controls not only light, but the silence of the image.",
      "confidence_score": 0.74,
