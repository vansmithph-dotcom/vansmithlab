  "claims": [
    {
      "id": "clm_3d-modeling-object-before-object_def",
      "wording_ru": "Цифровая геометрия позволяет построить, проверить и показать объект до физического прототипа. Тема рассматривается как система отношений между данными, инструментом, человеком и результатом, а не как название отдельной программы или машины.",
      "confidence_score": 0.72,
      "verification_state": "attributed"
    },
    {
      "id": "clm_3d-modeling-object-before-object_origin",
      "wording_ru": "Трёхмерное моделирование выросло из CAD, компьютерной графики и математического описания поверхностей. С ростом вычислительной мощности полигональные сетки, NURBS и твердотельные модели вошли в дизайн, архитектуру, кино и производство.",
      "confidence_score": 0.72,
      "verification_state": "attributed"
    },
    {
      "id": "clm_3d-modeling-object-before-object_method",
      "wording_ru": "Полигональная модель использует вершины, рёбра и грани; NURBS математически описывает гладкие кривые и поверхности; твердотельные системы работают с замкнутыми объёмами и операциями над ними. Принципиально важно отделять цифровое описание от физического или визуального результата: между ними всегда ",
      "confidence_score": 0.72,
      "verification_state": "attributed"
    },
    {
      "id": "clm_3d-modeling-object-before-object_case1",
      "wording_ru": "NURBS — управляемые гладкие оболочки. Этот пример важен как демонстрация базового принципа, а не только как историческая веха.",
      "confidence_score": 0.72,
      "verification_state": "attributed"
    },
    {
      "id": "clm_3d-modeling-object-before-object_impact",
      "wording_ru": "Тема изменила дисциплину тем, что перераспределила решения между человеком, данными, программой, машиной и материалом. Цифровая геометрия позволяет построить, проверить и показать объект до физического прототипа.",
      "confidence_score": 0.72,
      "verification_state": "attributed"
    },
    {
      "id": "clm_3d-modeling-object-before-object_today",
      "wording_ru": "Сегодня модель всё чаще входит в цифровой двойник вместе с материалами, метаданными, сканами и производственными параметрами; растёт значение устойчивых форматов хранения.",
      "confidence_score": 0.72,
      "verification_state": "attributed"
    }
  ],
